# Copy to .env (next to manage.py) and adjust. All values are optional for
# local development; the defaults give you a sqlite + local-memory setup.

# SECURITY: set a real secret key in production
# SECRET_KEY=change-me

# DEBUG must be false in production (default: false)
DEBUG=true

# Comma-separated list of hosts the site is served from
ALLOWED_HOSTS=127.0.0.1,localhost

# Postgres: when POSTGRES_DB is set, Postgres is used; otherwise sqlite.
# POSTGRES_DB=my_shop
# POSTGRES_USER=my_shop
# POSTGRES_PASSWORD=secret
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Redis: used for the cache when set
# REDIS_URL=redis://127.0.0.1:6379/0

# Collected static files and uploaded media locations
# STATIC_ROOT=/srv/my-shop/collected_static
# MEDIA_ROOT=/srv/my-shop/media
